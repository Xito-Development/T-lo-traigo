{
  "name": "tlotraigo-control",
  "productName": "T lo traigo Control",
  "version": "1.2.1",
  "description": "Panel de control de T lo traigo para el superadministrador: estado de los servicios, errores, actividad y sugerencias.",
  "author": "UNOCEROBITS · Xito Development <info@unocerobits.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "es.unocerobits.tlotraigo.control",
    "productName": "T lo traigo Control",
    "copyright": "© 2026 UNOCEROBITS y Xito Development",
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "recursos/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "recursos/icon.ico",
      "uninstallerIcon": "recursos/icon.ico",
      "installerSidebar": "recursos/installerSidebar.bmp",
      "uninstallerSidebar": "recursos/installerSidebar.bmp",
      "installerHeader": "recursos/installerHeader.bmp",
      "license": "recursos/licencia.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "T lo traigo Control",
      "runAfterFinish": true,
      "language": "3082",
      "artifactName": "TLoTraigo-Control-Setup-${version}.exe"
    }
  }
}